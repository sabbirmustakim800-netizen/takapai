<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <!-- ══════════════ মূল কনটেন্ট (অনুমতি পেলেই দেখা যায়) ══════════════ -->
    <ScrollView
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heading"
                android:textColor="#E8EEFC"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/intro"
                android:textColor="#8FA1C0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#111A2C"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:text="@string/status_unpaired"
                android:textColor="#B9C7E2"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/server_hint"
                android:inputType="textUri"
                android:padding="14dp"
                android:textColor="#E8EEFC"
                android:textColorHint="#5C6E8C"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/code_hint"
                android:inputType="textCapCharacters"
                android:maxLength="12"
                android:padding="14dp"
                android:textColor="#E8EEFC"
                android:textColorHint="#5C6E8C"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnPair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2EE6A8"
                android:text="@string/pair_button"
                android:textColor="#04211A" />

            <Button
                android:id="@+id/btnSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/sms_button" />

            <Button
                android:id="@+id/btnNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/notif_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/notif_hint"
                android:textColor="#5C6E8C"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sync_button" />

        </LinearLayout>
    </ScrollView>

    <!-- ══════════════ পারমিশন গেট (বাধ্যতামূলক) ══════════════ -->
    <ScrollView
        android:id="@+id/permissionGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1220"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gate_icon"
                android:textSize="48sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/gate_title"
                android:textColor="#E8EEFC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/gate_body"
                android:textColor="#8FA1C0"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGrant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:backgroundTint="#2EE6A8"
                android:text="@string/gate_grant"
                android:textColor="#04211A"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNotifGate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/gate_notif" />

            <Button
                android:id="@+id/btnOpenSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/gate_settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/gate_hint"
                android:textColor="#5C6E8C"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
