# এই ফাইলটি কপি করুন → android/keystore.properties
# (keystore.properties gitignore করা — কখনো কমিট হবে না)
#
# চাইলে ফাইল না বানিয়ে শুধু এনভায়রনমেন্ট ভ্যারিয়েবলও ব্যবহার করতে পারেন:
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

# android/ ফোল্ডারের সাপেক্ষে পাথ, অথবা absolute path
storeFile=release.keystore

# নিজের পাসওয়ার্ড বসান
storePassword=
keyAlias=takamatch
keyPassword=
