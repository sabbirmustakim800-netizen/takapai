# ── সার্ভার ───────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
DATABASE_FILE=./data/app.db

# ── ডিফল্ট নিয়ম (মার্চেন্ট চাইলে ড্যাশবোর্ড থেকে বদলাতে পারবে) ──
DEFAULT_ORDER_TTL_SECONDS=1800
DEFAULT_MATCH_WINDOW_BEFORE_SECONDS=300

# সেশন কতক্ষণ সক্রিয় থাকবে
SESSION_TTL_SECONDS=604800

# webhook-এ পাঠানো ডেটা সাইন করার জন্য (না দিলে ডেটাবেসের ভ্যালু ব্যবহার হয়)
# WEBHOOK_SECRET_OVERRIDE=

NODE_ENV=production
